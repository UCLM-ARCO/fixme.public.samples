# -*- mode:python; coding:utf-8 -*-

server = Test('$testdir/server $basedir/config',
              detach=True, save_stdout=True, signal=2)
server.post += FileContains('Hello World!')

client = Test('$testdir/client "$(head -1 %s)"' % server.stdout,
              shell=True)
client.pre += Poll(TaskRunning(server))

TaskTerminator(server, delay=1)
