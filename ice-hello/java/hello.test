# -*- mode:python; coding:utf-8 -*-

java = 'java -classpath .:/usr/share/java/Ice.jar'

server = Test('%s Server --Ice.Config=hello.cfg' % java,
              cwd='$testdir', detach=True, save_stdout=True, signal=2, expected=130,
              post = StdOutContains('Hello World!'))

Test('%s Client "$(head -1 %s)"' % (java, server.stdout),
     cwd='$testdir', shell=True,
     pre = Poll(FileContains("Hello", server.stdout)))

TaskTerminator(server, delay=1)
