# -*- mode:python; coding:utf-8 -*-

server = Test('./server.py --Ice.Config=../config',
              cwd='$testdir', detach=True, save_stdout=True, signal=2)
server.post += FileContains(['Hello World!', 'ping'])

client = Test('./client.py "$(head -1 %s)"' % server.stdout,
              cwd='$testdir', shell=True)
client.pre += Poll(TaskRunning(server))

TaskTerminator(server, delay=1)
