<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE glade-interface SYSTEM "glade-2.0.dtd">
<!--*- mode: xml -*-->
<glade-interface>
  <widget class="GtkWindow" id="window_hola">
    <property name="visible">True</property>
    <property name="title" translatable="yes">hola</property>
    <signal name="delete_event" handler="on_window_hola_delete_event"/>
    <child>
      <widget class="GtkButton" id="button_hola">
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="label" translatable="yes">hola</property>
        <property name="use_underline">True</property>
        <signal name="clicked" handler="on_button_hola_clicked"/>
      </widget>
    </child>
  </widget>
</glade-interface>
